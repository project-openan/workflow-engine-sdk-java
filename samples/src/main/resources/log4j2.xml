<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{1} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        <RollingFile name="File" fileName="logs/spn-demo.log"
                     filePattern="logs/spn-demo-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <!-- SDK diagnostic trace: full message content, SSE events, negotiation, extension handlers -->
        <Logger name="com.openan.a2at" level="DEBUG"/>
        <!-- Demo agents: INFO shows negotiation rounds + business progress -->
        <Logger name="com.openan.a2at.engine.examples" level="DEBUG"/>
        <!-- Underlying a2a-java SDK: reduce noise, keep warnings/errors -->
        <Logger name="org.a2aproject" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
