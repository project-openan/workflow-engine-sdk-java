<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openan.a2at</groupId>
        <artifactId>a2at-engine-java-parent</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>a2at-engine-java-samples</artifactId>
    <packaging>jar</packaging>

    <name>a2at-engine-java-samples</name>
    <description>Sample applications demonstrating the A2A-T workflow execution SDK</description>

    <dependencies>
       <!-- The workflow execution SDK -->
       <dependency>
           <groupId>com.openan.a2at</groupId>
           <artifactId>a2at-engine</artifactId>
           <version>${project.version}</version>
       </dependency>

        <!-- A2A protocol SDK (Java) - server side for agent servers -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <version>${a2a.java.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-transport-rest</artifactId>
            <version>${a2a.java.sdk.version}</version>
        </dependency>

        <!-- Logging implementation for demo console output -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
