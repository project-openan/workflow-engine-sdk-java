<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for the workflow engine.
  These patterns are either intentional design choices or false positives
  for this codebase's patterns. Clean up over time; new findings still block verify.
-->
<FindBugsFilter>
    <!-- Lombok-generated builder fluent setters store the caller's reference into the transient
         builder; build() routes through constructors that perform the defensive copies. -->
    <Match>
        <Class name="~.*\$.*Builder"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Engine-internal mutable-exposure acceptances (review on next touch):
         - NotificationSubscription: the live completion/acknowledgement futures ARE the API
         - RemoteA2AErrorException: error envelope headers, exception is terminal
         - WireLog.Entry: internal observability record, hot path
         - WorkflowEngineClientConfig: credentialsConfig already deep-copied/unmodifiable
         - WorkflowExecutor: stores collaborator references during assembly
         - A2AController: stores collaborator references during assembly -->
    <Match>
        <Or>
            <Class name="~.*NotificationSubscription"/>
            <Class name="~.*RemoteA2AErrorException"/>
            <Class name="~.*WireLog\$Entry"/>
            <Class name="~.*WorkflowEngineClientConfig"/>
            <Class name="~.*WorkflowExecutor"/>
            <Class name="~.*A2AController"/>
        </Or>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Lombok-generated equals/hashCode re-check fields the compiler knows are non-null. -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- Java serialization is not used by this project. -->
    <Match>
        <Or>
            <Bug pattern="SE_BAD_FIELD"/>
            <Bug pattern="SE_NO_SERIALVERSIONID"/>
        </Or>
    </Match>

    <!-- Throwing from constructors: no finalizers in this codebase, finalizer attack N/A. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Single-use SecureRandom: fresh instance per AES-GCM IV is intentional and safe. -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!-- Duplicated branch bodies in normalization (kept for symmetry with sibling branches). -->
    <Match>
        <Bug pattern="DB_DUPLICATE_BRANCHES"/>
    </Match>

    <!-- CompletableFuture exception paths in WorkflowExecutor intentionally ignore
         secondary failures when aggregating step results. -->
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING,DE_MIGHT_IGNORE"/>
    </Match>

    <!-- Generated fixtures and test code -->
    <Match>
        <Or>
            <Class name="~.*Test.*"/>
            <Class name="~.*Mock.*"/>
        </Or>
    </Match>

    <!-- The gateway adapter and protocol simulator packages exist only on the dev
         branch: their vendor-driven API shape, catch-and-continue request loops,
         token-service login retries, and Spring-style configuration holders are
         accepted there. On main the package does not exist and this filter
         matches nothing. -->
    <Match>
        <Package name="dev.openan.workflow.engine.examples.gateway"/>
    </Match>

    <!-- Samples/demo code: accepted demo-quality items; review on next touch.
         - Dead store in parseNegotiationContext (leftover context map)
         - Vacuous instanceof in NotificationPolicy (defensive String check)
         - NegotiationStrategy intentionally shadows the control interface name (sample mirror)
         - Boolean-returning booleanParam helper may return null to signal "unset"
         - handleLogin catches Exception broadly as the demo login boundary
         - doPrivileged warning: SecurityManager is not used by this project
         - OmcAgentLauncher.servers(): demo server registry, iterated by the demo only
         - SpringWorkbenchExecutor/SpringWorkbenchExtensionLifecycle: storing the Spring
           properties bean reference is the standard Spring configuration pattern -->
    <Match>
        <Or>
            <Class name="~.*NegotiationBaseAgentExecutor.*"/>
            <Class name="~.*NotificationPolicy.*"/>
            <Class name="~.*examples.negotiation.NegotiationStrategy"/>
            <Class name="~.*JdkHttpA2AServer.*"/>
            <Class name="~.*OmcAgentLauncher.*"/>
            <Class name="~.*SpringWorkbenchExecutor.*"/>
            <Class name="~.*SpringWorkbenchExtensionLifecycle.*"/>
            <Class name="~.*A2ATInitialization.*"/>
        </Or>
        <Bug pattern="DP_CREATE_CLASSLOADER_INSIDE_DO_PRIVILEGED"/>
    </Match>
    <Match>
        <Or>
            <Class name="~.*NegotiationBaseAgentExecutor.*"/>
            <Class name="~.*NotificationPolicy.*"/>
            <Class name="~.*examples.negotiation.NegotiationStrategy"/>
            <Class name="~.*JdkHttpA2AServer.*"/>
            <Class name="~.*OmcAgentLauncher.*"/>
            <Class name="~.*SpringWorkbenchExecutor.*"/>
            <Class name="~.*SpringWorkbenchExtensionLifecycle.*"/>
        </Or>
    </Match>
</FindBugsFilter>
