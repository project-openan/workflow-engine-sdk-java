<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openan.a2at</groupId>
    <artifactId>a2at-engine-java-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>a2at-engine-java-parent</name>
    <description>A2A-T workflow execution engine for multi-agent orchestration (Java) - parent</description>
    <url>https://github.com/project-openan/workflow-exec-engine</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <modules>
        <module>a2at-engine</module>
        <module>a2at-spring-boot-starter</module>
        <module>samples</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <a2a.java.sdk.version>1.0.0.Beta1</a2a.java.sdk.version>
        <a2a.t.sdk.version>1.0.0</a2a.t.sdk.version>
        <lombok.version>1.18.38</lombok.version>
        <jackson.version>2.20.1</jackson.version>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>5.10.2</junit.version>
        <log4j2.version>2.24.3</log4j2.version>
        <spring-boot.version>3.3.9</spring-boot.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
